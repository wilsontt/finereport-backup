# FineReport 備份工具前端
# Vite 7 需 Node ^20.19 或 >=22.12（見 frontend/package.json 之 vite、@vitejs/plugin-react）
FROM node:22-alpine AS builder

WORKDIR /app
# 複製 shared-ui
COPY 0.shared-ui /app/0.shared-ui
# 複製 frontend 並建立
COPY 4.FineReport備份工具/frontend/package*.json ./4.FineReport備份工具/frontend/
WORKDIR /app/4.FineReport備份工具/frontend
RUN npm ci
COPY 4.FineReport備份工具/frontend/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/4.FineReport備份工具/frontend/dist /usr/share/nginx/html
RUN chmod -R a+r /usr/share/nginx/html
COPY 4.FineReport備份工具/frontend/nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80 443
CMD ["nginx", "-g", "daemon off;"]
