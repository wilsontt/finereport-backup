.cursor/
.cursorignore
.gemini/
.vscode/
.idea/
.specify/
.claude/
CLAUDE.md

# === VCS / OS ===
.git/
.gitignore
.dockerignore
.DS_Store
._*
*.log

# === Frontend 產物 ===
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# === Backend 產物 ===
backend/node_modules/
backend/dist/
backend/build/
backend/coverage/

